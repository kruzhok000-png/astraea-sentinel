{
  "name": "astraea-sentinel",
  "version": "1.0.0",
  "private": true,
  "overrides": { "rollup": "4.64.9" },
  "description": "Production-ready CELESTIAL guild application bot",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --coverage",
    "test:core": "node --experimental-strip-types --test tests/core.native.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "discord.js": "14.25.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
